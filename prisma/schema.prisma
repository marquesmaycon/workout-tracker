generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions        Session[]
  accounts        Account[]
  gyms            Gym[]
  workouts        Workout[]
  workoutSessions WorkoutSession[]
  bodyWeightLogs  BodyWeightLog[]

  @@unique([email])
  @@map("user")
}

model Gym {
  id        String   @id @default(cuid())
  name      String
  favorite  Boolean  @default(false)
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSessions         WorkoutSession[]
  workoutSessionExercises WorkoutSessionExercise[]

  @@index([userId])
  @@map("gym")
}

model MuscleGroup {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exercises ExerciseMuscleGroup[]

  @@unique([name])
  @@map("muscle_group")
}

model Exercise {
  id           String   @id @default(cuid())
  name         String
  description  String?
  instructions String?
  videoUrl     String?  @map("video_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  muscleGroups            ExerciseMuscleGroup[]
  workoutExercises        WorkoutExercise[]
  workoutSessionExercises WorkoutSessionExercise[]

  @@index([name])
  @@map("exercise")
}

model ExerciseMuscleGroup {
  exerciseId    String  @map("exercise_id")
  muscleGroupId String  @map("muscle_group_id")
  isPrimary     Boolean @default(false) @map("is_primary")

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Restrict)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
  @@map("exercise_muscle_group")
}

model Workout {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises       WorkoutExercise[]
  workoutSessions WorkoutSession[]

  @@index([userId])
  @@map("workout")
}

model WorkoutExercise {
  id            String   @id @default(cuid())
  workoutId     String   @map("workout_id")
  exerciseId    String   @map("exercise_id")
  orderIndex    Int      @map("order_index")
  targetSetsMin Int?     @map("target_sets_min")
  targetSetsMax Int?     @map("target_sets_max")
  targetRepsMin Int?     @map("target_reps_min")
  targetRepsMax Int?     @map("target_reps_max")
  targetWeight  Decimal? @map("target_weight")
  restSeconds   Int?     @map("rest_seconds")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workout                 Workout                  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise                Exercise                 @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workoutSessionExercises WorkoutSessionExercise[]

  @@unique([workoutId, orderIndex])
  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercise")
}

model WorkoutSession {
  id         String               @id @default(cuid())
  userId     String               @map("user_id")
  workoutId  String               @map("workout_id")
  gymId      String?              @map("gym_id")
  startedAt  DateTime             @default(now()) @map("started_at")
  finishedAt DateTime?            @map("finished_at")
  status     WorkoutSessionStatus @default(IN_PROGRESS)
  notes      String?
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   Workout                  @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  gym       Gym?                     @relation(fields: [gymId], references: [id], onDelete: SetNull)
  exercises WorkoutSessionExercise[]

  @@index([userId])
  @@index([workoutId])
  @@index([gymId])
  @@index([startedAt])
  @@map("workout_session")
}

model WorkoutSessionExercise {
  id                String    @id @default(cuid())
  workoutSessionId  String    @map("workout_session_id")
  exerciseId        String    @map("exercise_id")
  workoutExerciseId String?   @map("workout_exercise_id")
  gymId             String?   @map("gym_id")
  orderIndex        Int       @map("order_index")
  plannedSetsMin    Int?      @map("planned_sets_min")
  plannedSetsMax    Int?      @map("planned_sets_max")
  plannedRepsMin    Int?      @map("planned_reps_min")
  plannedRepsMax    Int?      @map("planned_reps_max")
  plannedWeight     Decimal?  @map("planned_weight")
  actualSets        Int?      @map("actual_sets")
  actualReps        Int?      @map("actual_reps")
  actualWeight      Decimal?  @map("actual_weight")
  rpe               Decimal?
  completed         Boolean   @default(false)
  completedAt       DateTime? @map("completed_at")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workoutSession  WorkoutSession   @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise        Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workoutExercise WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id], onDelete: SetNull)
  gym             Gym?             @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@unique([workoutSessionId, orderIndex])
  @@index([workoutSessionId])
  @@index([exerciseId])
  @@index([workoutExerciseId])
  @@index([gymId])
  @@map("workout_session_exercise")
}

model BodyWeightLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  measuredAt DateTime @default(now()) @map("measured_at")
  weight     Decimal
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([measuredAt])
  @@map("body_weight_log")
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId], map: "account_issuer_account_id_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}
